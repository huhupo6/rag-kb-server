# ==========================================
# .dockerignore - Docker 构建忽略清单
# ==========================================

# 1. 虚拟环境与缓存
venv/
.git/
__pycache__/
*.pyc
*.pyo
*.pyd
*.log

# 2. 敏感环境变量
.env

# 3. 本地数据库与媒体文件（由 Docker Volume 管理）
db.sqlite3
media/
docs/images/

# 4. 庞大的模型文件与数据卷
models/           # BGE Reranker 模型
mineru_models/    # MinerU 模型
volumes/          # Milvus / etcd / minio 持久化数据

# 5. 测试与评测目录
eval/